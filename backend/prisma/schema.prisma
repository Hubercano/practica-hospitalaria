// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// -----------------------------------------------------------------------------
// 🛠️ ENUMS (Listas de valores fijos)
// -----------------------------------------------------------------------------

enum RequirementType {
  FILE // Requiere subir un PDF/Imagen
  TEXT // Un campo de texto simple
  DATE // Una fecha
  NUMBER // Un valor numérico
}

enum ValidationStatus {
  PENDING // Subido pero no revisado
  APPROVED // Revisado y aprobado
  REJECTED // Rechazado (debe subirse de nuevo)
  EXPIRED // Vencido por fecha
}

enum EntityState {
  ACTIVE
  INACTIVE
  BLOCKED
}

enum InductionStatus {
  DRAFT
  ACTIVE
  CLOSED
  CANCELLED
}

enum InductionLinkMode {
  PERMANENT
  TEMPORARY
}

enum InductionExpiryPolicy {
  FIXED_END_DATE
  DAYS_FROM_COMPLETION
}

enum InductionChannel {
  QR_PUBLIC
  ADMIN_MANUAL
}

enum SurveyStatus {
  ACTIVE
  INACTIVE
}

enum SurveyQuestionType {
  SHORT_TEXT
  LONG_TEXT
  SINGLE_CHOICE
  MULTIPLE_CHOICE
  SCALE
  DROPDOWN
}

enum SurveyAssignmentStatus {
  PENDING
  RESPONDED
}

enum SurveyDispatchChannel {
  EMAIL
}

enum SurveyDispatchStatus {
  SENT
  FAILED
}

enum UserRole {
  HOSPITAL
  INSTITUCION
}

enum UserStatus {
  ACTIVE
  BLOCKED
  DISABLED
}

enum CounterpartStatus {
  PENDING
  APPROVED
  REJECTED
}

// -----------------------------------------------------------------------------
// 🏗️ MÓDULO DE PARAMETRIZACIÓN (Configuracion del sistema)
// -----------------------------------------------------------------------------

// Paso 1: Definir los tipos (Ej: Universidad, Instituto Técnico, Colegio)
model InstitutionType {
  id          String  @id @default(uuid())
  name        String  @unique // Ej: "Universidad", "Sena"
  description String?

  // Relación: Un tipo tiene muchos requisitos definidos
  requirements RequirementDefinition[]

  // Relación: Un tipo tiene muchas instituciones inscritas
  institutions Institution[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime? // Soft Delete
}

// Paso 2: Definir QUÉ se pide para cada tipo (La "Plantilla")
model RequirementDefinition {
  id String @id @default(uuid())

  institutionTypeId String
  institutionType   InstitutionType @relation(fields: [institutionTypeId], references: [id])

  name               String // Ej: "Cámara de Comercio", "Registro Calificado"
  description        String? // Ej: "Debe ser menor a 30 días"
  type               RequirementType // FILE, TEXT, etc.
  isRequired         Boolean         @default(true)
  requiresExpiryDate Boolean         @default(false) // Si true, pide fecha de vencimiento obligatoria

  // Relación: Los valores entregados por las instituciones reales
  submissions InstitutionRequirementValue[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
}

// -----------------------------------------------------------------------------
// 🏥 MÓDULO DE INSTITUCIONES (La realidad operativa)
// -----------------------------------------------------------------------------

// Paso 3: La Institución en sí misma
model Institution {
  id String @id @default(uuid())

  name    String // Ej: "Universidad Nacional"
  nit     String  @unique
  email   String // Correo de contacto oficial
  phone   String?
  address String?

  // Clasificación
  typeId String
  type   InstitutionType @relation(fields: [typeId], references: [id])

  state EntityState @default(INACTIVE) // Nace inactiva hasta que cumpla requisitos

  // Relación: Sus documentos y datos específicos
  requirements InstitutionRequirementValue[]

  // Relación: Programas académicos
  programs AcademicProgram[]

  // Relación: Estudiantes asociados
  students Student[]

  users User[]
  counterpartRequests CounterpartRequest[]

  // Auditoría básica
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
}

model User {
  id String @id @default(uuid())

  email        String     @unique
  passwordHash String
  role         UserRole
  status       UserStatus @default(ACTIVE)

  institutionId String?
  institution   Institution? @relation(fields: [institutionId], references: [id])

  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?
  lastLoginAt         DateTime?
  passwordChangedAt   DateTime?

  sessions UserSession[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([role, status])
  @@index([institutionId])
}

model UserSession {
  id String @id @default(uuid())

  userId String
  user   User @relation(fields: [userId], references: [id])

  refreshTokenHash String   @unique
  expiresAt        DateTime
  revokedAt        DateTime?
  lastUsedAt       DateTime?

  ipAddress String?
  userAgent String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, expiresAt])
  @@index([revokedAt])
}

model CounterpartRequest {
  id String @id @default(uuid())

  name        String
  description String?

  institutionId String
  institution   Institution @relation(fields: [institutionId], references: [id])

  status CounterpartStatus @default(PENDING)

  fileUrl          String
  originalFileName String

  createdByUserId String?
  respondedByUserId String?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  respondedAt DateTime?
  deletedAt   DateTime?

  institutionSeenAt DateTime?
  hospitalSeenAt    DateTime?

  response CounterpartResponse?

  @@index([institutionId, status])
  @@index([institutionSeenAt])
  @@index([hospitalSeenAt])
  @@index([createdAt])
}

model CounterpartResponse {
  id String @id @default(uuid())

  counterpartRequestId String            @unique
  counterpartRequest   CounterpartRequest @relation(fields: [counterpartRequestId], references: [id])

  status CounterpartStatus

  valueWithoutDiscount Float?
  discountPercentage   Float?
  valueWithDiscount    Float?

  respondedByUserId String?
  responseDate      DateTime @default(now())
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([status, responseDate])
}

// Paso 4: El valor/documento entregado para cumplir un requisito
model InstitutionRequirementValue {
  id String @id @default(uuid())

  institutionId String
  institution   Institution @relation(fields: [institutionId], references: [id])

  definitionId String
  definition   RequirementDefinition @relation(fields: [definitionId], references: [id])

  // El contenido
  value String? // Si es TEXT/NUMBER guarda el valor. Si es FILE guarda la URL del S3/Storage.

  // Control de Vigencia (CRÍTICO para hospitales)
  issueDate  DateTime? // Fecha de expedición del documento
  expiryDate DateTime? // Fecha de vencimiento (Si la definición lo pide)

  // Estado de Aprobación
  status          ValidationStatus @default(PENDING)
  rejectionReason String? // Si se rechaza, aquí se dice por qué

  // Auditoría del documento
  reviewedBy String? // ID del usuario que aprobó/rechazó (futuro User)
  reviewedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// -----------------------------------------------------------------------------
// 🛡️ AUDITORÍA GLOBAL (Trazabilidad estricta)
// -----------------------------------------------------------------------------
model AuditLog {
  id        String   @id @default(uuid())
  action    String // CREATE, UPDATE, DELETE, APPROVE_DOC
  entity    String // Institution, Document, etc.
  entityId  String // ID del registro afectado
  userId    String // Quién lo hizo
  details   Json? // Valores anteriores vs nuevos (snapshot)
  ipAddress String?
  timestamp DateTime @default(now())
}

// -----------------------------------------------------------------------------
// 🎓 MÓDULO ACADÉMICO (Programas)
// -----------------------------------------------------------------------------

model AcademicProgram {
  id    String @id @default(uuid())
  name  String
  level String // "Pregrado", "Posgrado", "Técnico", etc.

  institutionId String?
  institution   Institution? @relation(fields: [institutionId], references: [id])

  technicalAnnex String? // URL to file
  state          EntityState @default(ACTIVE)

  // Relacion 1:N con Áreas de Rotación (Ahora pertenecen al programa)
  rotationAreas RotationArea[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
}

// -----------------------------------------------------------------------------
// ?? M�DULO CL�NICO (Servicios y Capacidad)
// -----------------------------------------------------------------------------

// El cat�logo maestro "Single Source of Truth"
model ClinicalService {
  id   String @id @default(uuid())
  code String @unique // Cdigo o distintivo del servicio (DHSS)
  name String // Nombre del servicio

  // Nuevos campos
  venueName     String? // Nombre de la sede prestadora
  venueSequence Int? // Consecutivo de la sede
  venueCode     String? // Código de la sede

  description String?
  isActive    Boolean @default(true)

  // Relaciones
  capacities ServiceCapacity[]

  // Relación implicita M:N con Áreas de Rotación (servicios asociados a áreas)
  rotationAreas RotationArea[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// �reas de Rotaci�n (Agrupaci�n l�gica de servicios para pr�cticas)
model RotationArea {
  id          String  @id @default(uuid())
  name        String
  description String?

  durationWeeks Int         @default(0)
  maxStudents   Int         @default(0)
  state         EntityState @default(ACTIVE)

  programId String?
  program   AcademicProgram? @relation(fields: [programId], references: [id])

  // Servicios asociados a esta área (M:N)
  services ClinicalService[]

  // Almacena los ids de servicios seleccionados (arreglo de strings)
  serviceIds String[] @default([])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Programación de Rotaciones: vincula institución, programa, área, docentes y estudiantes
model RotationSchedule {
  id String @id @default(uuid())

  institutionId String?
  programId     String?
  areaId        String?

  // Guardamos arrays de IDs para docentes y estudiantes para evitar cambios estructurales profundos
  teacherIds String[] @default([])
  studentIds String[] @default([])

  startDate DateTime
  endDate   DateTime

  surveyLinks RotationSurvey[]
  responses   SurveyResponse[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Capacidad Instalada (Definición de recursos por sede y servicios)
model ServiceCapacity {
  id String @id @default(uuid())

  // Nuevos campos solicitados con default temporal para migración
  headquarters     String  @default("") // Sede
  headquartersName String  @default("") // Nombre de la Sede
  capacityGroup    String? // Grupo de capacidad
  concept          String? // Concepto (agrupador)
  distinctiveCode  String? // Código de distintivo
  capacityQuantity Int     @default(0) // Cantidad de grupo de capacidad

  // Relación Muchos a Muchos con Servicios (Implicit M-N)
  services ClinicalService[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// -----------------------------------------------------------------------------
// 👨‍🎓 MÓDULO DE ESTUDIANTES (Gestión y Tipos)
// -----------------------------------------------------------------------------

// Paso 1: Tipos de Estudiante (Ej: Pregrado, Posgrado, Técnico, Especialización)
model StudentType {
  id          String  @id @default(uuid())
  name        String  @unique // Ej: "Estudiante de Pregrado", "Residente"
  description String?

  // Relación: Un tipo tiene muchos requisitos definidos (documentos de práctica)
  requirements StudentRequirementDefinition[]

  // Relación: Un tipo tiene muchos estudiantes
  students Student[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
}

// Paso 2: Requisitos de práctica por Tipo de Estudiante (La "Plantilla")
model StudentRequirementDefinition {
  id String @id @default(uuid())

  studentTypeId String
  studentType   StudentType @relation(fields: [studentTypeId], references: [id])

  name               String // Ej: "Carné de Vacunas", "Póliza de Responsabilidad"
  description        String?
  type               RequirementType // Mismo enum FILE, TEXT, etc.
  isRequired         Boolean         @default(true)
  requiresExpiryDate Boolean         @default(false)

  // Relación: Los documentos entregados por los estudiantes
  submissions StudentRequirementValue[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
}

// Paso 3: El Estudiante
model Student {
  id String @id @default(uuid())

  firstName    String
  lastName     String
  documentType String // Ej: "CC", "CE", "TI", "Pasaporte"
  document     String  @unique // Número de documento
  email        String  @unique
  phone        String?

  // Clasificación
  typeId String
  type   StudentType @relation(fields: [typeId], references: [id])

  institutionId String?
  institution   Institution? @relation(fields: [institutionId], references: [id])

  state EntityState @default(INACTIVE)

  // Gestión de carnet del estudiante
  numeroCarnet           String? // Número del carnet asignado al estudiante
  fechaDevolucionCarnet  DateTime? // Fecha cuando el estudiante devolvió el carnet

  // Relación: Sus documentos/requisitos de práctica entregados
  requirements StudentRequirementValue[]

  // Relación: Historial de inducciones realizadas
  inductionAttendances InductionAttendance[]     @relation("StudentInductionAttendances")
  allowedInductions    InductionAllowedStudent[] @relation("StudentAllowedInductions")

  surveyAssignments SurveyAssignment[]
  surveyResponses   SurveyResponse[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
}

// Paso 4: El valor/documento entregado por el Estudiante
model StudentRequirementValue {
  id String @id @default(uuid())

  studentId String
  student   Student @relation(fields: [studentId], references: [id])

  definitionId String
  definition   StudentRequirementDefinition @relation(fields: [definitionId], references: [id])

  // El contenido
  value String?

  // Control de Vigencia
  issueDate  DateTime?
  expiryDate DateTime?

  // Estado de Aprobación
  status          ValidationStatus @default(PENDING)
  rejectionReason String?

  // Auditoría
  reviewedBy String?
  reviewedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// -----------------------------------------------------------------------------
// 👨‍🏫 MÓDULO DE DOCENTES
// -----------------------------------------------------------------------------
model Teacher {
  id           String  @id @default(uuid())
  firstName    String
  lastName     String
  documentType String
  document     String  @unique
  phone        String?
  email        String  @unique

  supervisionType String
  contractType    String

  cvFile                  String?
  dataAuthorizationFile   String?
  conflictOfInterestFile  String?
  teacherTrainingFiles    String[] @default([])
  teacherRecognitionFiles String[] @default([])

  state EntityState @default(ACTIVE)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
}

// -----------------------------------------------------------------------------
// 🏥 MÓDULO DE INDUCCIONES
// -----------------------------------------------------------------------------
model Induction {
  id String @id @default(uuid())

  name   String
  status InductionStatus @default(DRAFT)

  startAt DateTime
  endAt   DateTime

  validityCode   String @default("ONE_YEAR")
  validityMonths Int    @default(12)

  expiryPolicy InductionExpiryPolicy @default(FIXED_END_DATE)
  expiryDays   Int?

  linkMode   InductionLinkMode @default(TEMPORARY)
  publicSlug String?           @unique

  accessTokens    InductionAccessToken[]
  allowedStudents InductionAllowedStudent[]
  attendances     InductionAttendance[]
  auditEvents     InductionAuditEvent[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([status, startAt, endAt])
}

model InductionAccessToken {
  id String @id @default(uuid())

  inductionId String
  induction   Induction @relation(fields: [inductionId], references: [id])

  tokenHash String    @unique
  expiresAt DateTime?
  isRevoked Boolean   @default(false)
  maxUses   Int?
  usesCount Int       @default(0)

  createdBy String?
  createdAt DateTime @default(now())

  @@index([inductionId, isRevoked, expiresAt])
}

model InductionAllowedStudent {
  id String @id @default(uuid())

  inductionId String
  induction   Induction @relation(fields: [inductionId], references: [id])

  studentId String?
  student   Student? @relation("StudentAllowedInductions", fields: [studentId], references: [id])

  document String
  source   String @default("MANUAL")

  createdAt DateTime @default(now())

  @@unique([inductionId, document])
  @@index([studentId])
}

model InductionAttendance {
  id String @id @default(uuid())

  inductionId String
  induction   Induction @relation(fields: [inductionId], references: [id])

  studentId String
  student   Student @relation("StudentInductionAttendances", fields: [studentId], references: [id])

  documentSnapshot String
  completedAt      DateTime
  expiresAt        DateTime

  channel   InductionChannel @default(QR_PUBLIC)
  ipAddress String?
  userAgent String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([inductionId, studentId])
  @@index([studentId, expiresAt])
}

model InductionAuditEvent {
  id String @id @default(uuid())

  inductionId String
  induction   Induction @relation(fields: [inductionId], references: [id])

  eventType String
  actor     String?
  details   Json?
  createdAt DateTime @default(now())

  @@index([inductionId, eventType])
}

// -----------------------------------------------------------------------------
// 📊 MÓDULO DE ENCUESTAS DE SATISFACCIÓN
// -----------------------------------------------------------------------------

model Survey {
  id String @id @default(uuid())

  name        String
  description String?
  status      SurveyStatus @default(INACTIVE)
  isPublished Boolean      @default(false)
  isOpenAccess Boolean     @default(false)

  questions SurveyQuestion[]
  rotations RotationSurvey[]
  responses SurveyResponse[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
}

model SurveyQuestion {
  id String @id @default(uuid())

  surveyId String
  survey   Survey @relation(fields: [surveyId], references: [id])

  title       String
  description String?
  type        SurveyQuestionType
  isRequired  Boolean @default(false)
  orderIndex  Int     @default(0)

  // Para tipo SCALE
  scaleMin  Int?
  scaleMax  Int?
  scaleStep Int?

  options SurveyQuestionOption[]
  answerDetails SurveyResponseDetail[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([surveyId, orderIndex])
}

model SurveyQuestionOption {
  id String @id @default(uuid())

  questionId String
  question   SurveyQuestion @relation(fields: [questionId], references: [id])

  label      String
  value      String
  orderIndex Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([questionId, orderIndex])
}

model RotationSurvey {
  id String @id @default(uuid())

  rotationScheduleId String
  rotationSchedule   RotationSchedule @relation(fields: [rotationScheduleId], references: [id])

  surveyId String
  survey   Survey @relation(fields: [surveyId], references: [id])

  status               EntityState @default(ACTIVE)
  assignedAt           DateTime    @default(now())
  sendAfterRotationEnd Boolean     @default(true)

  assignments SurveyAssignment[]
  responses   SurveyResponse[]

  @@unique([rotationScheduleId])
  @@index([surveyId])
}

model SurveyAssignment {
  id String @id @default(uuid())

  rotationSurveyId String
  rotationSurvey   RotationSurvey @relation(fields: [rotationSurveyId], references: [id])

  studentId String
  student   Student @relation(fields: [studentId], references: [id])

  status         SurveyAssignmentStatus @default(PENDING)
  tokenHash      String
  tokenExpiresAt DateTime?

  firstSentAt DateTime?
  lastSentAt  DateTime?
  sentCount   Int       @default(0)

  respondedAt DateTime?

  dispatchLogs SurveyDispatchLog[]
  response     SurveyResponse?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([rotationSurveyId, studentId])
  @@unique([tokenHash])
  @@index([status, respondedAt])
}

model SurveyDispatchLog {
  id String @id @default(uuid())

  assignmentId String
  assignment   SurveyAssignment @relation(fields: [assignmentId], references: [id])

  channel           SurveyDispatchChannel @default(EMAIL)
  status            SurveyDispatchStatus
  providerMessageId String?
  errorMessage      String?

  dispatchedAt DateTime @default(now())

  @@index([assignmentId, dispatchedAt])
}

model SurveyResponse {
  id String @id @default(uuid())

  assignmentId String? @unique
  assignment   SurveyAssignment? @relation(fields: [assignmentId], references: [id])

  rotationSurveyId String?
  rotationSurvey   RotationSurvey? @relation(fields: [rotationSurveyId], references: [id])

  surveyId String
  survey   Survey @relation(fields: [surveyId], references: [id])

  studentId String?
  student   Student? @relation(fields: [studentId], references: [id])

  rotationScheduleId String?
  rotationSchedule   RotationSchedule? @relation(fields: [rotationScheduleId], references: [id])

  submittedAt DateTime @default(now())
  ipAddress   String?
  userAgent   String?

  details SurveyResponseDetail[]

  @@index([surveyId, submittedAt])
  @@index([rotationScheduleId, submittedAt])
}

model SurveyResponseDetail {
  id String @id @default(uuid())

  responseId String
  response   SurveyResponse @relation(fields: [responseId], references: [id])

  questionId String
  question   SurveyQuestion @relation(fields: [questionId], references: [id])

  answerText        String?
  answerNumber      Float?
  answerOptionsJson Json?

  createdAt DateTime @default(now())

  @@index([questionId])
  @@index([responseId])
}
